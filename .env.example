# Copy to .env and fill in real values. Never commit .env or real secrets.
# Backend reads DATABASE_URL / SECRET_KEY; compose reads POSTGRES_*.

# --- Backend ---
# postgresql+psycopg://<user>:<password>@localhost:5432/<db>
DATABASE_URL=postgresql+psycopg://bizzai:bizzai@localhost:5432/bizzai
SECRET_KEY=change-me-to-a-long-random-value
ENVIRONMENT=development
# Dev frontend origin(s) allowed by backend CORS. Comma-separated or JSON list.
# Must include whichever port Next.js is actually using (3000 and/or 3001).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Session lifetime in minutes (default: 10080 = 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=bizzai
POSTGRES_PASSWORD=bizzai
POSTGRES_DB=bizzai
POSTGRES_PORT=5432

# --- Frontend (public; never put secrets in NEXT_PUBLIC_* vars) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM interpretation layer (optional; analytics work without it) ---
# LLM_PROVIDER=disabled
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_SECONDS=30
